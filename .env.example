# ── Vercel (관리자/사이트) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ── AI 제공자: 설정된 것만 사용, 실패 시 전환 순서(설정 > llm_chain)대로 넘어감 ──
ANTHROPIC_API_KEY=       # ① Claude
# Claude 모델·생각 깊이는 관리자 [AI 모델] 메뉴에서 작업별로 선택 (CLAUDE_MODEL 은 더 이상 쓰지 않음)
OPENAI_API_KEY=          # ② OpenAI (Responses API)
OPENAI_MODEL=gpt-5.5     # 사용 중인 계정에서 쓸 수 있는 모델명으로
# OPENAI_WEB_SEARCH=0    # OpenAI 내장 웹검색을 끄려면
OSS_BASE_URL=            # ③ 오픈소스: OpenAI 호환 주소 (예: https://openrouter.ai/api/v1 · https://api.groq.com/openai/v1 · 자체 vLLM/Ollama 의 …/v1)
OSS_API_KEY=             #    (자체 서버면 비워도 됨)
OSS_MODEL=               #    예: qwen/qwen3-… · meta-llama/… · 자체 서버의 모델명
# OSS_JSON_MODE=1        #    서버가 response_format json_object 를 지원하면
# 오픈소스 모델로 조사 단계를 돌릴 때 필요한 검색 (둘 중 하나)
TAVILY_API_KEY=
SEARXNG_URL=
# LLM_TIMEOUT_MS=120000
NEXT_PUBLIC_SITE_URL=https://today-policy-fund.vercel.app
# GitHub Actions 워커 호출용
GITHUB_REPO=owner/today-policy-fund
GITHUB_TOKEN=            # fine-grained PAT: Contents(Read/Write) — 워커 호출 + SOP 커밋
WORKER_SECRET=           # 워커 ↔ Vercel API 공유 비밀값 (임의 긴 문자열)
MCP_TOKEN=               # /api/mcp 접근 토큰 (임의 긴 문자열). 비우면 MCP 서버 꺼짐
# ── 이메일 알림 (둘 중 하나) ──
RESEND_API_KEY=
EMAIL_FROM=              # 예: 오늘의 정책자금 <noti@yourdomain.kr>  (SMTP 면 비워도 SMTP_USER 사용)
SMTP_HOST=               # 예: smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=               # Gmail 은 앱 비밀번호
CRON_SECRET=             # 하루 요약·SOP 학습 크론(vercel.json) 인증용 임의 문자열
# ── 데이터 내보내기 ──
# GitHub: 기본은 GITHUB_REPO 의 data 브랜치 (GITHUB_TOKEN 에 Contents 쓰기 권한 필요). 다른 저장소면:
# GITHUB_DATA_REPO=owner/tpf-data
# GITHUB_DATA_TOKEN=
# 구글 시트 서비스 계정 방식 (Apps Script 방식이면 비워둠): 서비스 계정 키 JSON 한 줄 전체
GOOGLE_SERVICE_ACCOUNT_JSON=
# 유튜브 OAuth (리프레시 토큰 발급 페이지용)
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# ── GitHub Actions Secrets (워커) ─────────────────
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SITE_URL, WORKER_SECRET
# FISH_AUDIO_API_KEY
# YT_CLIENT_ID, YT_CLIENT_SECRET, YT_REFRESH_TOKEN
# IG_USER_ID, IG_ACCESS_TOKEN, (선택) GRAPH_VERSION=v21.0, IG_GRAPH_HOST(Instagram 로그인 토큰이면 graph.instagram.com)
# (선택) YT_API_KEY — 채널 성과 수집용 YouTube Data API 키
